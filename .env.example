PORT=8080
MONGODB_URI=mongodb://localhost:27017/yes_hotels
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Configure this exact value as the webhook secret in the Razorpay Dashboard
# (Settings > Webhooks) pointing at POST https://<your-domain>/api/webhooks/razorpay,
# subscribed to at least: payment.captured, payment.failed, refund.processed, refund.failed.
# Required in production whenever RAZORPAY_KEY_ID is set — the server fails to boot without it.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email / SMTP
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# App
CLIENT_URL=http://localhost:8080

# Tests connect to mongodb://localhost:27017/yes_hotels_test by default (see
# vitest.config.ts). If your machine has something else already bound to
# 27017 (another local MongoDB, a Docker container, etc.) and tests fail with
# "does not support retryable writes" or connect to the wrong database,
# create a gitignored .env.test.local with:
#   TEST_MONGODB_URI=mongodb://<host>:<port>/yes_hotels_test
# pointing at a real single-node replica set (booking transactions require
# one) that isn't subject to the port conflict.
