# Copy to /etc/yeshotels-seo.env on the server, owner root, mode 600. NEVER commit the real file.
# The daily audit needs none of these today: it only reads public pages.

# --- optional overrides ---
# SEO_AGENT_ATTEMPTS=3            # tries per run before it is marked failed
# SEO_AGENT_RETRY_WAIT_MS=120000  # wait between tries

# --- future integrations (not used yet; keep the secret in a FILE, not in this variable) ---
# GSC_SERVICE_ACCOUNT_FILE=/run/secrets/gsc-service-account.json   # Search Console, read-only scope
# GBP_OAUTH_TOKEN_FILE=/run/secrets/gbp-token.json                 # Google Business Profile
# SEO_ALERT_WEBHOOK_URL=                                           # where failure alerts go (not implemented yet)
